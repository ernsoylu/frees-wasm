/target
**/target
/pkg
/web/node_modules
/web/dist
# Generated by wasm-pack (see web/WASM-PORT.md for the rebuild command)
web/src/wasm/pkg/
# ...and where wasm-pack puts it when --out-dir is omitted. A stale copy sat
# here untracked from 2026-08-21 until Wave T5; it was two waves out of date
# and nothing referenced it, which is exactly how it went unnoticed.
crates/frees-wasm/pkg/
Cargo.lock.bak
*.wasm
!fixtures/**/*.wasm

# Java helper-tool build output (golden-dumper, dae-probe, table-gen)
tools/*/build/

# rollup-plugin-visualizer output — regenerated by every `npm run build`
web/stats.html

# TypeScript incremental build cache — regenerated by every `tsc`/`npm run build`
web/tsconfig.tsbuildinfo

# Written by the Pages deploy workflow (.github/workflows/deploy.yml) before
# the Vite build, standing in for the nginx image's container-start entrypoint.
web/public/build-info.js
