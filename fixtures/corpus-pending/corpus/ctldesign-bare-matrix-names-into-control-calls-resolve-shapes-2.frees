A[1,1] = 0; A[1,2] = 1
A[2,1] = -2; A[2,2] = -3
B[1,1] = 0; B[2,1] = 1
C[1,1] = 1; C[1,2] = 0
G[1,1] = 1; G[1,2] = 0
G[2,1] = 0; G[2,2] = 1
