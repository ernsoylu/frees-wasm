// 4-way electrical node via connect: V equal on every member, sum I = 0.
VoltageSource V1(E = 12)
Ground        GND()
Resistor      R1(R = 100)
Resistor      R2(R = 200)
Resistor      R3(R = 300)
Resistor      R4(R = 600)
connect(V1.p, R1.a)
connect(R1.b, R2.a, R3.a, R4.a)
connect(R2.b, R3.b, R4.b, V1.n, GND.port)
i1 = R1.a.I
i2 = R2.a.I
i3 = R3.a.I
i4 = R4.a.I
vm = R1.b.V
