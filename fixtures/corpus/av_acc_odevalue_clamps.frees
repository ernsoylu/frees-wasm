{ ODEValue outside the table's span clamps to the nearest end rather than
  extrapolating or failing. }
Vbefore = ODEValue('Temp', -100)
Vafter  = ODEValue('Temp', 1000)
Vexact0 = ODEValue('Temp', 0)
VexactN = ODEValue('Temp', 60)

DYNAMIC cooling (method = ode45, time = 0 .. 60, points = 7)
  der(Temp) = -0.05*(Temp - 20)
  Temp(0) = 95
END
