{ Two DYNAMIC blocks each own a distinct column; the accessor must resolve the
  column to the right table. }
Afin = FinalValue('Alpha')
Bfin = FinalValue('Beta')

DYNAMIC first (method = ode45, time = 0 .. 4, points = 5)
  der(Alpha) = 1
  Alpha(0) = 0
END

DYNAMIC second (method = ode45, time = 0 .. 4, points = 5)
  der(Beta) = -2
  Beta(0) = 10
END
