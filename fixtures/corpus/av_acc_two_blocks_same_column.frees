{ Two blocks whose state has the SAME name. Which table an unqualified
  accessor picks is the thing under test. }
Vfin = FinalValue('Level')

DYNAMIC first (method = ode45, time = 0 .. 4, points = 5)
  der(Level) = 1
  Level(0) = 0
END

DYNAMIC second (method = ode45, time = 0 .. 4, points = 5)
  der(Level) = -3
  Level(0) = 100
END
