TorqueSource     TS(T=5)
Inertia          J(J=1, w0=0)
RotationalSpring SP(k=4, theta0=0)
RotationalDamper D(c=2)
MechGround       GS()
MechGround       GA()
MechGround       GD()
connect(TS.a, J.port, SP.a, D.a)
connect(TS.b, GS.port)
connect(SP.b, GA.port)
connect(D.b, GD.port)
DYNAMIC smd(method = ode45, time = 0 .. 50, points = 200)
END
theta_final = FinalValue('sp.theta')
