COMPONENT Widget(in, out)
  PARAM model$ = linear
  out.mdot = in.mdot
  out.P    = in.P
  VARIANT linear REQUIRE gain
    out.h = in.h + gain
  END
  VARIANT scaled REQUIRE factor
    out.h = in.h * factor
  END
END
Widget W(s1, s2, model$=bogus, gain=1)
s1.P    = 100000
s1.mdot = 3
s1.h    = 1000
