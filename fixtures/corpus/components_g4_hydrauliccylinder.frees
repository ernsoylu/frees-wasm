// Single-acting cylinder extending against a viscous load at steady state
// (der(P) -> 0 pins mdot = rho * area * vel): 50 bar supply on a 20 cm2
// piston drives 9800 N into a 20 kN.s/m damper -> vel = 0.49 m/s,
// mdot = 870 * 0.002 * 0.49 = 0.8526 kg/s.
HydraulicSupply   SUP(P=5000000)
HydraulicCylinder CYL(rho=870, beta=1.5e9, V0=0.0005, area=0.002, Patm=100000, P0=5000000)
TransDamper       DMP(c=20000)
TransGround       GND()
connect(SUP.out, CYL.in)
connect(CYL.rod, DMP.a)
connect(DMP.b, GND.port)
v_rod = CYL.rod.vel
q_in  = CYL.in.mdot
