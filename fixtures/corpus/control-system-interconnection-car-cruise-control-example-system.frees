m = 1000 [kg]
c = 50 [N-s/m]
A = [0, 1; 0, -c/m]
B = [0; 1/m]
C = [0, 1]
D = [0]
CALL ss2tf(A, B, C, D : num_car[1:3], den_car[1:3])
Kp = 800 [N-s/m]
Ki = 40 [N/m]
num_pi = [Kp, Ki]
den_pi = [1, 0]
CALL series(num_pi, den_pi, num_car, den_car : num_ol[1:4], den_ol[1:4])
num_h = [1]
den_h = [1]
CALL feedback(num_ol, den_ol, num_h, den_h : num_cl[1:4], den_cl[1:4])
