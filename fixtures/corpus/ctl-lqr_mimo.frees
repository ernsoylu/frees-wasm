{ Two-input LQR — K is 2x3. }
A[1,1] = 0; A[1,2] = 1; A[1,3] = 0
A[2,1] = 0; A[2,2] = 0; A[2,3] = 1
A[3,1] = 1; A[3,2] = 2; A[3,3] = 3
B[1,1] = 1; B[1,2] = 0
B[2,1] = 0; B[2,2] = 1
B[3,1] = 1; B[3,2] = 1
Q[1,1] = 1; Q[1,2] = 0; Q[1,3] = 0
Q[2,1] = 0; Q[2,2] = 1; Q[2,3] = 0
Q[3,1] = 0; Q[3,2] = 0; Q[3,3] = 1
R[1,1] = 1; R[1,2] = 0
R[2,1] = 0; R[2,2] = 4
[K] = lqr(A, B, Q, R)
