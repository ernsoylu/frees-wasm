{ Pole placement two ways on the same plant. }
A[1,1] = 0; A[1,2] = 1
A[2,1] = -2; A[2,2] = -3
B[1] = 0; B[2] = 1
pd_r = [-4, -5]
pd_i = [0, 0]
[Kp] = place(A, B, pd_r, pd_i)
[Ka] = acker(A, B, pd_r, pd_i)
Acl[1,1] = A[1,1]-B[1]*Kp[1]; Acl[1,2] = A[1,2]-B[1]*Kp[2]
Acl[2,1] = A[2,1]-B[2]*Kp[1]; Acl[2,2] = A[2,2]-B[2]*Kp[2]
[cr, ci] = pole(Acl)
