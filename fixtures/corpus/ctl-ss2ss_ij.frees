A[1,1] = 0; A[1,2] = 1
A[2,1] = -2; A[2,2] = -3
B[1,1] = 0; B[1,2] = 1
B[2,1] = 1; B[2,2] = 0
C[1,1] = 1; C[1,2] = 0
C[2,1] = 0; C[2,2] = 1
D[1,1] = 0; D[1,2] = 0
D[2,1] = 0; D[2,2] = 0
[n11, d11] = ss2tfij(A, B, C, D, 1, 1)
[n21, d21] = ss2tfij(A, B, C, D, 2, 1)
P[1,1] = 1; P[1,2] = 1
P[2,1] = 0; P[2,2] = 1
CALL ss2ss(A, B, C, D, P : An[1:2,1:2], Bn[1:2,1:2], Cn[1:2,1:2], Dn[1:2,1:2])
