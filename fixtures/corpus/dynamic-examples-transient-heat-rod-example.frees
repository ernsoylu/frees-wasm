N = 6
L = 1
dx = L / (N - 1)
alpha = 0.05
T_left  = 100
T_right = 0
T_init  = 0
DYNAMIC rod (method = ode23s, t = 0 .. 300, points = 150, rtol = 1e-6)
  FOR i = 2 TO N-1
    der(T[i]) = alpha / dx^2 * (T[i-1] - 2*T[i] + T[i+1])
  END
  T[1] = T_left
  T[6] = T_right
  T[2:N-1](0) = T_init
END
T_mid_final = FinalValue('t[4]')
