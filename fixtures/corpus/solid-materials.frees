{ SolidProperties: the whole material table, every property. }
vk_al = k_(Aluminum)
vr_al = rho_(Aluminum)
vc_al = c_(Aluminum)
ve_al = E_(Aluminum)
vn_al = nu_(Aluminum)

vk_alu = k_(Aluminium)
vr_alu = rho_(Aluminium)
vc_alu = c_(Aluminium)
ve_alu = E_(Aluminium)
vn_alu = nu_(Aluminium)

vk_cu = k_(Copper)
vr_cu = rho_(Copper)
vc_cu = c_(Copper)
ve_cu = E_(Copper)
vn_cu = nu_(Copper)

vk_st = k_(Steel)
vr_st = rho_(Steel)
vc_st = c_(Steel)
ve_st = E_(Steel)
vn_st = nu_(Steel)

vk_cs = k_(CarbonSteel)
vr_cs = rho_(CarbonSteel)
vc_cs = c_(CarbonSteel)
ve_cs = E_(CarbonSteel)
vn_cs = nu_(CarbonSteel)

vk_ss = k_(StainlessSteel)
vr_ss = rho_(StainlessSteel)
vc_ss = c_(StainlessSteel)
ve_ss = E_(StainlessSteel)
vn_ss = nu_(StainlessSteel)

vk_fe = k_(Iron)
vr_fe = rho_(Iron)
vc_fe = c_(Iron)
ve_fe = E_(Iron)
vn_fe = nu_(Iron)

vk_br = k_(Brass)
vr_br = rho_(Brass)
vc_br = c_(Brass)
ve_br = E_(Brass)
vn_br = nu_(Brass)

vk_bz = k_(Bronze)
vr_bz = rho_(Bronze)
vc_bz = c_(Bronze)
ve_bz = E_(Bronze)
vn_bz = nu_(Bronze)

vk_au = k_(Gold)
vr_au = rho_(Gold)
vc_au = c_(Gold)
ve_au = E_(Gold)
vn_au = nu_(Gold)

vk_ag = k_(Silver)
vr_ag = rho_(Silver)
vc_ag = c_(Silver)
ve_ag = E_(Silver)
vn_ag = nu_(Silver)

vk_pb = k_(Lead)
vr_pb = rho_(Lead)
vc_pb = c_(Lead)
ve_pb = E_(Lead)
vn_pb = nu_(Lead)

vk_ni = k_(Nickel)
vr_ni = rho_(Nickel)
vc_ni = c_(Nickel)
ve_ni = E_(Nickel)
vn_ni = nu_(Nickel)

vk_ti = k_(Titanium)
vr_ti = rho_(Titanium)
vc_ti = c_(Titanium)
ve_ti = E_(Titanium)
vn_ti = nu_(Titanium)

vk_w = k_(Tungsten)
vr_w = rho_(Tungsten)
vc_w = c_(Tungsten)
ve_w = E_(Tungsten)
vn_w = nu_(Tungsten)

vk_zn = k_(Zinc)
vr_zn = rho_(Zinc)
vc_zn = c_(Zinc)
ve_zn = E_(Zinc)
vn_zn = nu_(Zinc)

vk_mg = k_(Magnesium)
vr_mg = rho_(Magnesium)
vc_mg = c_(Magnesium)
ve_mg = E_(Magnesium)
vn_mg = nu_(Magnesium)

vk_cc = k_(Concrete)
vr_cc = rho_(Concrete)
vc_cc = c_(Concrete)
ve_cc = E_(Concrete)
vn_cc = nu_(Concrete)

vk_gl = k_(Glass)
vr_gl = rho_(Glass)
vc_gl = c_(Glass)
ve_gl = E_(Glass)
vn_gl = nu_(Glass)

vk_bk = k_(Brick)
vr_bk = rho_(Brick)
vc_bk = c_(Brick)

vk_wd = k_(Wood)
vr_wd = rho_(Wood)
vc_wd = c_(Wood)
ve_wd = E_(Wood)

vk_ok = k_(Oak)
vr_ok = rho_(Oak)
vc_ok = c_(Oak)
ve_ok = E_(Oak)

vk_ic = k_(Ice)
vr_ic = rho_(Ice)
vc_ic = c_(Ice)
ve_ic = E_(Ice)
vn_ic = nu_(Ice)

{ Case-insensitive material lookup. }
vk_lower = k_(aluminum)
vk_upper = k_(ALUMINUM)
vk_mixed = k_(AlUmInUm)

{ Temperature form: linear slopes about 300 K for the metals that carry one. }
tk_al = k_(Aluminum, T=400)
tc_al = c_(Aluminum, T=400)
tk_cu = k_(Copper, T=500)
tc_cu = c_(Copper, T=500)
tk_st = k_(Steel, T=600)
tc_st = c_(Steel, T=600)
tk_cs = k_(CarbonSteel, T=250)
tc_cs = c_(CarbonSteel, T=250)
tk_fe = k_(Iron, T=400)
tc_fe = c_(Iron, T=400)
tk_ni = k_(Nickel, T=400)
tc_ni = c_(Nickel, T=400)
tk_ti = k_(Titanium, T=400)
tc_ti = c_(Titanium, T=400)
tk_w = k_(Tungsten, T=400)
tc_w = c_(Tungsten, T=400)
tk_alu = k_(Aluminium, T=400)
tc_alu = c_(Aluminium, T=400)
tk_ref = k_(Aluminum, T=300)

{ Materials with no slope keep the constant. }
tk_ss = k_(StainlessSteel, T=400)
tc_ss = c_(StainlessSteel, T=400)
tk_gl = k_(Glass, T=400)

{ Properties other than k_/c_ ignore the temperature entirely. }
tr_al = rho_(Aluminum, T=400)
te_al = E_(Aluminum, T=400)
tn_al = nu_(Aluminum, T=400)
