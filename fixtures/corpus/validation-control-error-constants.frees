// VALIDATION: Static error constants of a type-0 plant
// AREA: Control systems
// BASIS: G(s) = (8s + 16)/(s^2 + 5s + 4): Kp = G(0) = 16/4 = 4 exactly; a
// type-0 system has Kv = 0 and Ka = 0.
// EXPECT Kp = 4 tol 1e-9
// EXPECT Kv = 0 tol 1e-9
// EXPECT Ka = 0 tol 1e-9
num = [8, 16]
den = [1, 5, 4]
CALL errorconst(num[1:2], den[1:3] : Kp, Kv, Ka)
