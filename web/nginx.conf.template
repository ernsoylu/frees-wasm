# Static serving only. The engine is WebAssembly inside the bundle, so there
# is no backend to proxy, no client address to recover, and no rate limit to
# enforce — the /api/ proxy blocks, the limit_req zone and the real_ip
# machinery that this file carried in the server-based deployment are gone
# with the server (Phase 11; docs/dependency-map.md lists them under deleted
# infrastructure). What remains is exactly what a dumb static host does, which
# is the point: this container is a convenience, not a requirement.
#
# Deliberately absent: Cross-Origin-Opener-Policy / Cross-Origin-Embedder-
# Policy. D3 (docs/decisions/0003-threading-model.md) rules out requiring
# them; the PWA and worker pool run without cross-origin isolation.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Nothing here accepts uploads; measurement files are read in-tab.
    client_max_body_size 1m;

    # Compression. This container served the whole bundle uncompressed until
    # now — 19.3 MB on the wire where 6.2 MB would do, and the two biggest
    # files are the ones that suffer most (the 3.3 MB wasm engine gzips to
    # 1.8 MB, the 5.4 MB spreadsheet chunk to 1.5 MB). Vercel compresses at
    # its edge, so only the Docker path was affected, which is why it went
    # unnoticed.
    #
    # `gzip_static on` serves the .gz siblings the Dockerfile precompresses at
    # `gzip -9`, so the runtime spends no CPU on the big immutable assets;
    # `gzip on` is the fallback for anything without a sibling (build-info.js,
    # which is written at container start).
    gzip_static on;
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    # application/wasm is not in nginx's default gzip_types, and it is the
    # single largest asset in the bundle.
    gzip_types
        application/javascript
        application/json
        application/manifest+json
        application/wasm
        image/svg+xml
        text/css
        text/plain
        text/xml;

    # Vite emits content-hashed filenames under /assets, so a new build always
    # has new URLs — cache them forever and skip revalidation.
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/security-headers.conf;
        try_files $uri $uri/ /index.html;
        # The HTML shell, the service worker (sw.js), the web app manifest and
        # the runtime build-info stamp are NOT hashed, so they must revalidate
        # on every load. For sw.js this is load-bearing: an HTTP-cached service
        # worker would pin users to a stale precache long after a deploy.
        add_header Cache-Control "no-cache";
    }
}
