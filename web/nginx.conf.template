# Resolve the REAL client address before anything below keys off it.
#
# Behind an edge proxy — Railway's router, a Pangolin/Traefik tunnel — every
# request arrives from that proxy, so $remote_addr is the same address for all
# users, and the rate limit below would put everyone in one shared bucket
# (letting one abusive client 429 the rest). real_ip fixes that by recovering
# the client address from X-Forwarded-For, which also makes the X-Real-IP we
# forward carry the true client (see clientIp() in RequestGuardFilter).
#
# Generated by docker-entrypoint.d/10-real-ip.sh from TRUSTED_PROXY_CIDRS, and
# EMPTY unless that is set: which hops are trustworthy is deployment specific,
# and trusting the wrong ones lets a client forge its own address. See that
# script for why the private ranges are not a safe default here.
include /etc/nginx/real-ip.conf;

# Per-client-IP request rate limit for the API (DoS guard). 10 req/s sustained
# with a burst of 20; excess returns 429. Defined here (http context via
# conf.d include) so it applies to the /api proxy below.
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_status 429;

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Reject oversized request bodies before they reach the backend.
    client_max_body_size 1m;

    # Measurement uploads (Data Analyzer .mf4 files) get a dedicated, larger
    # body cap — longest-prefix match beats /api/, every other route keeps 1m.
    # Mirrors the backend's own per-route cap in RequestGuardFilter; the
    # backend still counts streamed bytes, so this is the outer of three
    # enforcement layers, not the only one.
    # Liveness probe: no rate limit. It performs no dependency work — it only
    # confirms the JVM can serve a request — and a platform's deploy/restart
    # check must never be throttled, or a burst of probes can make a healthy
    # instance look dead and trigger a restart loop. The backend exempts this
    # path too (RequestGuardFilter); this keeps the guarantee true end to end.
    # Longest-prefix match beats both /api/health and /api/ below.
    location /api/health/live {
        include /etc/nginx/security-headers.conf;

        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $backend_host ${BACKEND_HOST};
        proxy_pass http://$backend_host:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/measurements {
        include /etc/nginx/security-headers.conf;
        limit_req zone=api burst=20 nodelay;
        client_max_body_size 210m;

        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $backend_host ${BACKEND_HOST};
        proxy_pass http://$backend_host:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ {
        include /etc/nginx/security-headers.conf;
        limit_req zone=api burst=20 nodelay;

        # Re-resolve the backend on every request instead of caching the IP for
        # the life of the worker. A bare `proxy_pass http://host:8080;` makes
        # nginx resolve ${BACKEND_HOST} ONCE at startup; on Railway's private
        # network the backend's IPv6 changes on every redeploy, so a stale cache
        # makes all of /api hang (Cloudflare 504) until the frontend is
        # restarted. Putting the host in a variable forces per-request DNS via
        # the container resolver. NGINX_LOCAL_RESOLVERS is populated from
        # /etc/resolv.conf by the image's built-in 15-local-resolvers.envsh
        # entrypoint (enabled via NGINX_ENTRYPOINT_LOCAL_RESOLVERS in the Dockerfile).
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $backend_host ${BACKEND_HOST};
        proxy_pass http://$backend_host:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Vite emits content-hashed filenames under /assets, so a new build always
    # has new URLs — cache them forever and skip revalidation.
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/security-headers.conf;
        try_files $uri $uri/ /index.html;
        # The HTML shell and the runtime build-info stamp are NOT hashed, so they
        # must revalidate on every load — otherwise a deploy isn't picked up until
        # a hard refresh (the stale-index.html problem).
        add_header Cache-Control "no-cache";
    }
}
